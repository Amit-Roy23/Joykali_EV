# Joykali EV Mobility — environment variables
# Local:  copy to .env   |   Vercel: Project → Settings → Environment Variables
# (Do NOT set NODE_ENV yourself — Next.js/Vercel set it.)

# MongoDB connection string. Must be a replica set (MongoDB Atlas always is).
# Local Docker example below; on Vercel use your Atlas "mongodb+srv://…" string
# with the database name in the path, e.g. …mongodb.net/joykali_ev?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/joykali_ev

# Login token signing keys — two DIFFERENT random values, 32+ characters each.
# Generate with:  openssl rand -hex 32
# (The values below are public dev defaults; production refuses to use them.)
JWT_ACCESS_SECRET=joykali_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=joykali_jwt_refresh_secret_super_secure_key_67890

# Protects the daily job (/api/cron/payroll) that drafts last month's payroll on the
# 1st and switches approved salary revisions. Vercel sends it automatically.
# Any random 32+ character value:  openssl rand -hex 32
CRON_SECRET=

# "true" shows one-click demo accounts on the login page. Use "false" for a real
# production rollout. Baked in at build time: redeploy after changing it.
NEXT_PUBLIC_DEMO_MODE=true
